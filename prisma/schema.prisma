// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
}

model User {
  userId        String    @id @default(uuid()) @db.Uuid
  username      String    @unique
  email         String    @unique
  password      String
  created_at    DateTime  @default(now())

  categories    Category[]
  wallets       Wallet[]
  transactions  Transaction[]
}

model Category {
  categoryId    String @id @default(uuid()) @db.Uuid
  userId        String @db.Uuid
  name          String
  type          String

  user          User  @relation(fields: [userId], references: [userId], onDelete: Cascade)
  transactions  Transaction[]

  @@index([userId])
}

model Wallet {
  walletId    String @id @default(uuid()) @db.Uuid
  userId      String @db.Uuid
  walletName  String
  balance     Decimal @db.Decimal(19, 4)
  update_at   DateTime  @default(now())

  user      User  @relation(fields: [userId], references: [userId], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
}

model Transaction {
  transactionId   String  @id @default(uuid()) @db.Uuid
  walletId        String  @db.Uuid
  categoryId      String  @db.Uuid
  transactionDate DateTime
  amount          Decimal @db.Decimal()
  description     String
  transactionType String

  wallet   Wallet   @relation(fields: [walletId], references: [walletId], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [categoryId], onDelete: Restrict)
  user     User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  userId   String   @db.Uuid

  @@index([walletId])
  @@index([categoryId])
  @@index([userId, transactionDate])
}